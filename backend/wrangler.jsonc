{
  "name": "shopai-backend",
  "main": "dist/app.js",
  "build": { "command": "node build.mjs" },
  "compatibility_date": "2026-11-07",
  "workers_dev": true,
  "preview_urls": true,
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "ai": {
    "binding": "AI"
  },
  "ratelimits": [
    {
      "name": "AI_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "vars": {
    "ACCESS_TEAM_DOMAIN": "restless-butterfly-687f.cloudflareaccess.com",
    "ACCESS_AUD": "ff20e92c80e07676c17aa8c812769813ff3aaf0407e58bdf76fa02a844c630a0",
    "ALLOWED_ORIGINS": "https://pthub2026.github.io,https://shopai-backend.ct-3f8.workers.dev",
    "AI_MODEL": "@cf/meta/llama-3.1-8b-instruct"
  },
  "previews": {
    "vars": {
      "ACCESS_TEAM_DOMAIN": "restless-butterfly-687f.cloudflareaccess.com",
      "ACCESS_AUD": "ff20e92c80e07676c17aa8c812769813ff3aaf0407e58bdf76fa02a844c630a0",
      "ALLOWED_ORIGINS": "",
      "AI_MODEL": "@cf/meta/llama-3.1-8b-instruct"
    },
    "ai": {
      "binding": "AI"
    },
    "ratelimits": [
      {
        "name": "AI_RATE_LIMITER",
        "namespace_id": "1002",
        "simple": {
          "limit": 10,
          "period": 60
        }
      }
    ],
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "shopai-drafts-preview",
        "database_id": "543ddfdd-8b74-4a2b-8b41-f9a2c4ba5306",
        "migrations_dir": "migrations"
      }
    ]
  }
}

