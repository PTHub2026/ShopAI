{
  "name": "shopai-backend",
  "main": "src/app.js",
  "compatibility_date": "2026-11-07",
  "workers_dev": true,
  "preview_urls": true,
  "ai": {
    "binding": "AI"
  },
  "ratelimits": [
    {
      "name": "AI_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "vars": {
    "ACCESS_TEAM_DOMAIN": "restless-butterfly-687f.cloudflareaccess.com",
    "ACCESS_AUD": "ff20e92c80e07676c17aa8c812769813ff3aaf0407e58bdf76fa02a844c630a0",
    "ALLOWED_ORIGINS": "https://pthub2026.github.io",
    "AI_MODEL": "@cf/meta/llama-3.1-8b-instruct"
  },
  "rules": [
    {
      "type": "Text",
      "globs": [
        "**/*.html"
      ],
      "fallthrough": true
    }
  ],
  "previews": {
    "vars": {
      "ACCESS_TEAM_DOMAIN": "restless-butterfly-687f.cloudflareaccess.com",
      "ACCESS_AUD": "ff20e92c80e07676c17aa8c812769813ff3aaf0407e58bdf76fa02a844c630a0",
      "ALLOWED_ORIGINS": "",
      "AI_MODEL": "@cf/meta/llama-3.1-8b-instruct"
    },
    "ai": {
      "binding": "AI"
    },
    "ratelimits": [
      {
        "name": "AI_RATE_LIMITER",
        "namespace_id": "1002",
        "simple": {
          "limit": 10,
          "period": 60
        }
      }
    ]
  }
}
