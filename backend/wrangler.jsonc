{
  "name": "shopai-backend",
  "main": "dist/app.js",
  "build": {
    "command": "node build.mjs"
  },
  "compatibility_date": "2026-11-07",
  "workers_dev": true,
  "preview_urls": true,
  "keep_vars": true,
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "ai": {
    "binding": "AI"
  },
  "ratelimits": [
    {
      "name": "AI_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "vars": {
    "ACCESS_TEAM_DOMAIN": "restless-butterfly-687f.cloudflareaccess.com",
    "ACCESS_AUD": "ff20e92c80e07676c17aa8c812769813ff3aaf0407e58bdf76fa02a844c630a0",
    "ALLOWED_ORIGINS": "https://pthub2026.github.io,https://shopai-backend.ct-3f8.workers.dev",
    "AI_MODEL": "@cf/google/gemma-4-26b-a4b-it",
    "ZALO_APP_ID": "3847703053447967855",
    "PUBLIC_ORIGIN": "https://shoppost.net",
    "EMAIL_FROM": "Shoppost <no-reply@shoppost.net>",
    "PLATFORM_ADMIN_EMAILS": "ct@pthub.vn",
    "EMAIL_LOGIN_DOMAINS": "pthub.vn,shoptrack.vn",
    "META_APP_ID": "1690219679401963",
    "META_REDIRECT_URI": "https://shoppost.net/api/social/meta/callback",
    "GOOGLE_REDIRECT_URI": "https://shoppost.net/api/social/google/callback",
    "DRIVE_REDIRECT_URI": "https://shoppost.net/api/library/drive/callback"
  },
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "previews": {
    "vars": {
      "ACCESS_TEAM_DOMAIN": "restless-butterfly-687f.cloudflareaccess.com",
      "ACCESS_AUD": "ff20e92c80e07676c17aa8c812769813ff3aaf0407e58bdf76fa02a844c630a0",
      "ALLOWED_ORIGINS": "",
      "AI_MODEL": "@cf/google/gemma-4-26b-a4b-it",
      "ZALO_APP_ID": "3847703053447967855"
    },
    "ai": {
      "binding": "AI"
    },
    "ratelimits": [
      {
        "name": "AI_RATE_LIMITER",
        "namespace_id": "1002",
        "simple": {
          "limit": 10,
          "period": 60
        }
      }
    ],
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "shopai-drafts-preview",
        "database_id": "543ddfdd-8b74-4a2b-8b41-f9a2c4ba5306",
        "migrations_dir": "migrations"
      }
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shopai-drafts-production",
      "database_id": "50da4192-8c86-4168-b3ff-5ef11f6e3a96",
      "migrations_dir": "migrations"
    }
  ],
  "routes": [
    {
      "pattern": "shoppost.net/*",
      "zone_name": "shoppost.net"
    },
    {
      "pattern": "www.shoppost.net/*",
      "zone_name": "shoppost.net"
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  }
}
